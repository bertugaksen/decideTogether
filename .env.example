# ==============================================================================
# DecideTogether Environment Variables Example
# ==============================================================================
# Copy this file to .env and customize the values for your environment:
# cp .env.example .env
# ==============================================================================

# Server Port
PORT=3001

# Environment (development | production | test)
NODE_ENV=development

# Allowed CORS client origin (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173

# Google Places API (New) Key
# If omitted or left empty, the backend falls back to curated local mock venues (Moda, Beşiktaş, etc.)
GOOGLE_PLACES_API_KEY=

# Persistence Storage ('sqlite' | 'memory')
STORAGE_TYPE=sqlite
SQLITE_DB_PATH=./data/decidetogether.sqlite

# ==============================================================================
# HTTP Rate Limiting (express-rate-limit)
# ==============================================================================

# General API rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_GENERAL_WINDOW_MS=60000

# General API max requests per window per IP (default: 120)
RATE_LIMIT_GENERAL_MAX=120

# Max location resolve requests (/api/locations/resolve) per minute per IP (default: 30)
RATE_LIMIT_LOCATIONS_MAX=30

# Max venue photo proxy requests (/api/venues/photo) per minute per IP (default: 120)
RATE_LIMIT_PHOTOS_MAX=120

# ==============================================================================
# WebSocket Rate Limiting & Abuse Prevention
# ==============================================================================

# Max WebSocket messages allowed per second per socket (default: 50)
# Rapid Tapper duel batches taps every 80ms (~12-15 packets/sec), 50 allows smooth play while preventing spam.
WS_MAX_MSG_PER_SEC=50

# Hard limit for WebSocket messages per second before closing connection with 1008 policy violation (default: 100)
WS_ABUSE_MSG_PER_SEC=100

# Max new WebSocket connections allowed per minute per IP address (default: 30)
WS_MAX_CONN_PER_MIN=30
